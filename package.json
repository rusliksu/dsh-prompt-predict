{
  "name": "dsh-prompt-predict",
  "version": "0.2.10-ruslan.7",
  "description": "Форк dsh-prompt-predict для DeepSeek Harness: предзагрузка подсказки в конце хода, свой системный промпт и доп. инструкции, режим «только по Tab», принятие по Enter/Tab/→ и отправка вторым нажатием, русский интерфейс ｜ Fork of dsh-prompt-predict: host-side prefetch, custom prompt settings, Enter/Tab/→ accept with send-on-second-press, Russian UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "CHANGELOG.md",
    "CHANGELOG_zh.md"
  ],
  "scripts": {
    "test": "node test/predict.mjs && node test/client-render.mjs",
    "test:smoke": "node test/dsh-smoke.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pretest": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "pack": "pnpm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferrisching/dsh-prompt-predict.git"
  },
  "homepage": "https://github.com/ferrisching/dsh-prompt-predict#readme",
  "bugs": {
    "url": "https://github.com/ferrisching/dsh-prompt-predict/issues"
  },
  "author": "ferrisching",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-prediction",
    "composer",
    "ghost-text"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
